# GEMINI_API_KEY: Required for AI-powered theological commentary and research.
# Get your key at https://aistudio.google.com/app/apikey
# Set this in your hosting provider's dashboard — never commit this file with a real key.
#
# Railway (recommended):  https://railway.app → New Project → Deploy from GitHub
#   Add GEMINI_API_KEY under Variables in the Railway dashboard.
#   railway.toml handles build/start/healthcheck automatically.
#
# Render (alternative):  render.yaml in this repo handles the config.
#   Set GEMINI_API_KEY under Environment in the Render dashboard.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional. Overrides the Gemini model used for all AI endpoints.
# Defaults to gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash

