# GEMINI_API_KEY: Required for commentary, follow-up, traditions, and word study.
# Get your key at https://aistudio.google.com/app/apikey
# Set this in your hosting provider's dashboard — never commit a real key.
#
# Local: copy this file to .env.local (preferred) or .env.
# The server loads .env.local first, then .env.
GEMINI_API_KEY=

# GEMINI_MODEL: Flash model for word study. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# GEMINI_MODEL_PRO: Grounded commentary / follow-up / traditions. Default: gemini-2.5-pro
# GEMINI_MODEL_PRO=gemini-2.5-pro

# ESV_API_KEY: Optional. Official Crossway ESV with section headings.
# Without it, English uses Bolls Life. Request a key at https://api.esv.org/
ESV_API_KEY=
